{
  "name": "climcalc-core",
  "version": "0.1.0",
  "description": "Climate and economic transition simulation engine for cities and municipalities",
  "type": "module",
  "scripts": {
    "extract": "python3 scripts/extraction_webfassung.py \"examples/data/Klimarechner 260630 für Webfassung.xlsx\" tests/fixtures/webfassung_260630.json",
    "zero:schools": "python3 scripts/zero_schools.py",
    "build:wasm": "PATH=\"$HOME/.cargo/bin:$PATH\" wasm-pack build --target nodejs --out-dir pkg",
    "build:wasm:web": "PATH=\"$HOME/.cargo/bin:$PATH\" wasm-pack build --target web --out-dir pkg-web",
    "dev": "npm --prefix frontend run dev",
    "test": "vitest run",
    "test:rust": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo test",
    "verify:units": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo test --test verify_equations",
    "docs:equations": "python3 scripts/export_equations_md.py"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}